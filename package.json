{
  "name": "dsh-plugin-lark",
  "description": "Feishu/Lark bridge for DeepSeek Harness with turn, tool, and approval cards",
  "version": "0.8.1",
  "author": "LPX-E5BD8",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LPX-E5BD8/dsh-plugin-lark.git"
  },
  "homepage": "https://github.com/LPX-E5BD8/dsh-plugin-lark#readme",
  "bugs": {
    "url": "https://github.com/LPX-E5BD8/dsh-plugin-lark/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.zh-CN.md",
    "ROADMAP.md",
    "SMOKE_TESTS.md",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "feishu",
    "lark",
    "plugin"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check": "npm test && npm run typecheck && npm run build",
    "prepare": "npm run build",
    "test:pack": "node scripts/pack-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@types/node": "^22.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
